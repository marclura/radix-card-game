$card-stack-offset = 0.35rem
$card-stack-offset-disabled = 0.2rem
$card-stack-offset-pick = 0
$card-stack-count = 6

.card-decks-container
    display: flex
    width: 95%
    justify-content: space-between

    /*
    for color, value in colorMap
        &[data-color={color}]
            .card-deck
                border-color: value
    */

.card-aspect
    aspect-ratio: 63 / 88
    border-radius: 0.6rem

.card
    @extends .card-aspect
    border: 0.15rem solid $primary
    background-repeat: no-repeat
    background-position: center center
    background-size: 75%

    &:active
        position: relative
        top: - $card-stack-offset-pick

.card-deck
    width: 20%
    background-size: 70%
    padding: 0
    @extends .card-aspect
    position: relative
    border: none
    box-sizing: content-box

    &:active
        background-color: unset

    &.disabled
        .card
            background-color: $disabled-bg !important

.card-deck-card-stack
    @extends .card
    width: 100%
    position: absolute
    background-color: $background
    &:active
        position: absolute  // important else it gets in conflict with pos: relative

.card-deck-1
    background-image: url('../../assets/cards/card-icon-1.svg')
    background-color: $card-red !important

.card-deck-2
    background-image: url('../../assets/cards/card-icon-2.svg')
    background-color: $card-silver !important

.card-deck-3
    background-image: url('../../assets/cards/card-icon-3.svg')
    background-color: $card-green !important


// card stack

// Mixin: generates stack offsets for a given horizontal property
card-stack-offsets(dir, offset = $card-stack-offset, offset-disabled = $card-stack-offset-disabled)
    for i in 1..$card-stack-count
        .card-stack-{i}
            z-index: -1 * i
            top: offset * i
            {dir}: offset * i

// Mixin: disabled (collapsed) state
card-stack-offsets-disabled(dir, offset-disabled = $card-stack-offset-disabled)
    for i in 1..$card-stack-count
        .card-stack-{i}
            top: offset-disabled * i
            {dir}: offset-disabled * i

// --- Player 1 (left controller): stacks face RIGHT ---
.controller-p1
    card-stack-offsets(right)

    .card-deck.disabled
        card-stack-offsets-disabled(right)

// --- Player 2 (right controller): stacks face LEFT (unchanged) ---
.controller-p2
    card-stack-offsets(left)

    .card-deck.disabled
        card-stack-offsets-disabled(left)